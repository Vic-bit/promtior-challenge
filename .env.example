DATABASE_URL=postgresql://postgres:postgres@localhost:5432/booking
GROQ_API_KEY=your-groq-api-key
AGENT_MODEL=openai/gpt-oss-20b
GUARDIAN_MODEL=openai/gpt-oss-20b
# At least 32 bytes. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-32-byte-secret
JWT_EXPIRE_MINUTES=60
TIMEZONE=America/Montevideo

# Optional: tracing with LangSmith
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=your-langsmith-api-key
